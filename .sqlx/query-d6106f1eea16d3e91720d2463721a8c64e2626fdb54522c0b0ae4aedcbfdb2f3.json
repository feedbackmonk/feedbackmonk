{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT short_code,\n                   kind,\n                   moderation_status,\n                   left(body, 200) AS body_excerpt,\n                   end_user_email,\n                   anon_token_hash IS NOT NULL AS is_anonymous,\n                   accepted_at\n            FROM feedback\n            WHERE tenant_id = $1 AND project_id = $2 AND moderation_status = $3\n            ORDER BY accepted_at DESC\n            LIMIT $4 OFFSET $5\n            ",
